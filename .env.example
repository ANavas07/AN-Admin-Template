# Copia este archivo como .env y ajusta los valores.
# Solo las variables con prefijo VITE_ llegan al bundle del navegador.
# No pongas secretos aqui: todo lo que este en VITE_* es publico.

VITE_APP_NAME="System Panel 2026"
VITE_APP_ORGANIZATION="Mi Organizacion"
VITE_APP_LOCATION="Sede principal"
VITE_API_BASE_URL="http://localhost:3000/api"

# Canales de soporte (pagina 403, Centro de soporte, paginas de error)
VITE_SUPPORT_EMAIL="soporte@example.com"
VITE_SUPPORT_PHONE="+593 2 000 0000"
VITE_SUPPORT_HOURS="Lunes a viernes, 08:00 – 18:00"

# Modo mantenimiento: true muestra la pagina de mantenimiento en toda la app
VITE_MAINTENANCE_MODE="false"
# Opcionales: mensaje, fin estimado (ISO 8601) y pagina de estado
VITE_MAINTENANCE_MESSAGE=""
VITE_MAINTENANCE_UNTIL=""
VITE_STATUS_PAGE_URL=""
